ENV=dev
DATABASE_URL=postgresql+psycopg://locky:locky@localhost:5432/locky
CORS_ORIGINS=["http://localhost:5173"]
# Opcional: regex de origens extras (ex.: previews do Vercel)
# CORS_ORIGIN_REGEX=https://locky-web-.*\.vercel\.app
# Em produção (ENV=prod) a API não sobe com a chave padrão. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-secret-trocar-em-producao-locky
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
TEMPO_MAXIMO_RESERVA_MINUTOS=120
EXPIRACAO_INTERVALO_MINUTOS=5
FUSO_HORARIO=America/Sao_Paulo
# Em produção (ENV=prod) o seed recusa a senha padrão; use 10+ caracteres.
SEED_ADMIN_EMAIL=admin@locky.com
SEED_ADMIN_PASSWORD=admin123
