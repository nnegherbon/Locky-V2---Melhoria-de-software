  "components": {
    "schemas": {
      "CreateLockerRequest": {
        "properties": {
          "number": {
            "type": "string",
            "maxLength": 10,
            "title": "Number"
          },
          "size": {
            "$ref": "#/components/schemas/LockerSizeAPI"
          },
          "status": {
            "$ref": "#/components/schemas/LockerAdminStatusAPI",
            "default": "available"
          }
        },
        "type": "object",
        "required": [
          "number",
          "size"
        ],
        "title": "CreateLockerRequest"
      },
      "CreateReservationRequest": {
        "properties": {
          "locker_id": {
            "type": "integer",
            "title": "Locker Id"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "time": {
            "type": "string",
            "format": "time",
            "title": "Time"
          }
        },
        "type": "object",
        "required": [
          "locker_id",
          "date",
          "time"
        ],
        "title": "CreateReservationRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "LockerAdminStatusAPI": {
        "type": "string",
        "enum": [
          "available",
          "maintenance"
        ],
        "title": "LockerAdminStatusAPI",
        "description": "Status que o administrador pode definir manualmente.\n\n`reserved` e `occupied` são consequência das reservas; permitir que o admin\nos definisse à mão deixaria o armário dessincronizado da tabela de reservas."
      },
      "LockerListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/LockerResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "LockerListResponse"
      },
      "LockerResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "number": {
            "type": "string",
            "title": "Number"
          },
          "status": {
            "$ref": "#/components/schemas/LockerStatusAPI"
          },
          "size": {
            "$ref": "#/components/schemas/LockerSizeAPI"
          }
        },
        "type": "object",
        "required": [
          "id",
          "number",
          "status",
          "size"
        ],
        "title": "LockerResponse"
      },
      "LockerSizeAPI": {
        "type": "string",
        "enum": [
          "small",
          "medium",
          "large"
        ],
        "title": "LockerSizeAPI"
      },
      "LockerStatsResponse": {
        "properties": {
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "available": {
            "type": "integer",
            "title": "Available"
          },
          "reserved": {
            "type": "integer",
            "title": "Reserved"
          },
          "occupied": {
            "type": "integer",
            "title": "Occupied"
          },
          "maintenance": {
            "type": "integer",
            "title": "Maintenance"
          }
        },
        "type": "object",
        "required": [
          "total",
          "available",
          "reserved",
          "occupied",
          "maintenance"
        ],
        "title": "LockerStatsResponse"
      },
      "LockerStatusAPI": {
        "type": "string",
        "enum": [
          "available",
          "reserved",
          "occupied",
          "maintenance"
        ],
        "title": "LockerStatusAPI"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "RegisterRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 6,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "name",
          "email",
          "password"
        ],
        "title": "RegisterRequest"
      },
      "ReservationListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ReservationResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "title": "ReservationListResponse"
      },
      "ReservationResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "locker_id": {
            "type": "integer",
            "title": "Locker Id"
          },
          "locker_number": {
            "type": "string",
            "title": "Locker Number"
          },
          "locker_size": {
            "$ref": "#/components/schemas/LockerSizeAPI"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "time": {
            "type": "string",
            "format": "time",
            "title": "Time"
          },
          "status": {
            "$ref": "#/components/schemas/ReservationStatusAPI"
          }
        },
        "type": "object",
        "required": [
          "id",
          "locker_id",
          "locker_number",
          "locker_size",
          "date",
          "time",
          "status"
        ],
        "title": "ReservationResponse"
      },
      "ReservationStatusAPI": {
        "type": "string",
        "enum": [
          "active",
          "completed",
          "cancelled"
        ],
        "title": "ReservationStatusAPI"
      },
      "TokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          }
        },
        "type": "object",
        "required": [
          "access_token"
        ],
        "title": "TokenResponse"
      },
      "UpdateLockerRequest": {
        "properties": {
          "number": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 10
              },
              {
                "type": "null"
              }
            ],
            "title": "Number"
          },
          "size": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LockerSizeAPI"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LockerAdminStatusAPI"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "UpdateLockerRequest",
        "description": "Atualização parcial: só os campos enviados são alterados."
      },
      "UserResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "title": "Role"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "role"
        ],
        "title": "UserResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
